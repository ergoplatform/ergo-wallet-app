CREATE TABLE IF NOT EXISTS `multisig_transactions` (
    `id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    `wallet_first_address` TEXT NOT NULL,
    `tx_id` TEXT,
    `state` INTEGER AS Int NOT NULL,
    `memo` TEXT,
    `last_json` TEXT,
    `depends_on_tx_ids` TEXT,
    `last_change` INTEGER NOT NULL
);

selectAll:
SELECT * FROM multisig_transactions;

loadByWalletAddress:
SELECT * FROM multisig_transactions WHERE wallet_first_address = ?;

loadById:
SELECT * FROM multisig_transactions WHERE id = ?;

insertOrReplace:
INSERT OR REPLACE INTO `multisig_transactions` (
    `id`,`wallet_first_address`,`tx_id`,`state`,`memo`,`last_json`,`depends_on_tx_ids`,`last_change`
) VALUES (?,?,?,?,?,?,?,?);

deleteById:
DELETE FROM multisig_transactions WHERE id = ?;

deleteByTxId:
DELETE FROM multisig_transactions WHERE tx_id = ?;

updateState:
UPDATE multisig_transactions SET state = ?, last_change = ? WHERE id = ?;
